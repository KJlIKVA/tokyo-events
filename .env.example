# Скопируйте в .env для локального запуска. В GitHub — Settings → Secrets and variables → Actions.
# Файл .env в git не попадает. Токены не вставляйте в чат.

# OpenAI API (модель — в config.yaml)
OPENAI_API_KEY=

# Telegram: токен бота от @BotFather и ваш личный chat id (куда слать уведомления)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# цены отелей 楽天トラベル (uv run tokyo-events setup-rakuten)
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
